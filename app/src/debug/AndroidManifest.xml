<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions: the T02 vehicle probe and demo commands. Release builds never contain these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".debug.VehicleProbeActivity"
            android:exported="true" />

        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.plenty.debug.SEED_DEMO" />
                <action android:name="app.plenty.debug.RESET" />
                <action android:name="app.plenty.debug.ARRIVAL_REGION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
